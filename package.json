{
	"name": "dsh-quote-context",
	"version": "0.2.1",
	"description": "聊天引用：选中消息文字即可引用或评论；引用收在输入卡顶部的「聊天引用」芯片里，悬停展开预览，发送瞬间才进入消息正文，输入框里永远只有你自己的文字。",
	"icon": "icon.svg",
	"license": "MIT",
	"author": "YHX",
	"keywords": [
		"dsh",
		"dsh-plugin",
		"deepseek-harness",
		"quote",
		"selection",
		"annotation",
		"composer-chip",
		"collapsible"
	],
	"type": "module",
	"main": "lib/index.js",
	"engines": {
		"dsh": ">=0.2.1-rc.3",
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json",
		"./locale/*.json": "./locale/*.json"
	},
	"files": [
		"icon.svg",
		"lib",
		"locale",
		"test",
		"docs",
		"cordis.patch.yml",
		"README.md",
		"README.en.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node test/check.mjs && node test/quote.mjs && node test/render.mjs"
	},
	"dsh": {
		"manifestVersion": 1,
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Yhx888/dsh-quote-context.git"
	},
	"homepage": "https://github.com/Yhx888/dsh-quote-context#readme",
	"bugs": {
		"url": "https://github.com/Yhx888/dsh-quote-context/issues"
	}
}
